{
  "name": "holt-app",
  "version": "0.3.3",
  "description": "Local-first research harness for persistent human/agent collaboration",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "build:sidecar": "npx esbuild agent-sdk-bridge.js --bundle --platform=node --target=node18 --outfile=src-tauri/resources/agent-sdk-bridge.bundle.js --format=esm --external:@anthropic-ai/claude-agent-sdk --external:@anthropic-ai/claude-code --external:zod"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@anthropic-ai/claude-code": "^2.1.226",
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.6",
    "marked-highlight": "^2.2.4",
    "xterm": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "esbuild": "^0.28.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "~5.6.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
