{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holt",
  "mainBinaryName": "holt",
  "version": "0.9.5",
  "identifier": "dev.hearthbyte.holt",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:sidecar",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Holt",
        "width": 1280,
        "height": 800,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Holt"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/agent-sdk-bridge.bundle.js",
      "resources/persona-registry/**/*"
    ]
  }
}
